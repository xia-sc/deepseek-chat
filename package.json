{
  "name": "deepseek-chat",
  "version": "0.2.2",
  "description": "基于 DeepSeek API 的静态聊天示例。",
  "license": "MIT",
  "author": "xia-sc",
  "private": true,
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "rspack serve -c rspack.config.ts",
    "dev:desktop": "cross-env DEEPSEEK_CHAT_DEV_URL=http://localhost:8090 electron . --no-sandbox",
    "dev:desktop:win": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/dev-desktop.ps1",
    "build": "rspack build -c rspack.config.ts",
    "desktop": "pnpm build && electron .",
    "dist:exe": "pnpm check:main && pnpm build && electron-builder --win",
    "check:main": "node scripts/check-main.cjs",
    "type": "tsc -p tsconfig.json",
    "lint": "oxlint src rspack.config.ts",
    "format": "oxfmt --write ."
  },
  "build": {
    "appId": "com.deepseek.chat.desktop",
    "productName": "DeepSeek Chat",
    "directories": {
      "output": "E:/build/deepseek-chat"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "resources/**/*",
      "package.json"
    ],
    "win": {
      "target": [
        "portable",
        "zip"
      ],
      "icon": "resources/icon.ico"
    },
    "portable": {
      "artifactName": "DeepSeek-Chat-${version}-portable.exe"
    }
  },
  "dependencies": {
    "@types/katex": "^0.16.5",
    "@types/mdast": "~4.0.3",
    "@types/prismjs": "^1.26.1",
    "@types/react": "~18.3.1",
    "@types/react-dom": "~18.3.0",
    "clsx": "2.1.1",
    "fflate": "0.8.3",
    "idb": "8.0.3",
    "katex": "0.16.22",
    "mdast-util-find-and-replace": "3.0.2",
    "mdast-util-from-markdown": "2.0.3",
    "mdast-util-gfm": "3.1.0",
    "mdast-util-math": "3.0.0",
    "mermaid": "11.10.1",
    "micromark-extension-gfm": "3.0.0",
    "micromark-extension-llm-math": "3.1.0",
    "prismjs": "1.30.0",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "zustand": "4.4.7"
  },
  "devDependencies": {
    "@rspack/cli": "2.0.2",
    "@rspack/core": "2.0.2",
    "@rspack/dev-server": "2.0.1",
    "@swc/helpers": "0.5.23",
    "@types/node": "~20.9.2",
    "cross-env": "^10.1.0",
    "electron": "^45.3.3",
    "electron-builder": "^26.18.0",
    "oxfmt": "0.48.0",
    "oxlint": "1.63.0",
    "typescript": "7.0.2"
  }
}
